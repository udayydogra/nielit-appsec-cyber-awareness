# ─────────────────────────────────────────────────────────────────────────────
# NIELIT AppSec + Cyber-Awareness Platform — environment
# Pick ONE mentor profile (A / B / C). Everything is env-driven; nothing hard-coded.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
API_PORT=4000

# ── Secrets ── generate real ones, NEVER commit:  openssl rand -hex 32
JWT_SECRET=dev-only-change-me-openssl-rand-hex-32
CERT_SIGNING_SECRET=dev-only-change-me-openssl-rand-hex-32
SESSION_COOKIE_NAME=nielit_sid

# ── Postgres ──
PGHOST=postgres
PGPORT=5432
PGUSER=nielit
PGPASSWORD=nielit
PGDATABASE=nielit

# ── Redis ──
REDIS_URL=redis://redis:6379

# ── Tiered execution / memory guards (the 5GB reality) ──
MAX_CONCURRENT_CONTAINERS=12
CONTAINER_MEMORY_MB=192            # headroom for apt installs on the Debian lab boxes
CONTAINER_CPUS=0.5
CONTAINER_IDLE_TIMEOUT_SEC=360      # 6 min idle → reaped
CONTAINER_MAX_LIFETIME_SEC=1800     # 30 min alive → reaped
CONTAINER_RUNTIME=runc              # set to "runsc" for gVisor on escape labs

# ── Rate limits (DoS guards) ──
RATE_LAB_START_PER_MIN=10
RATE_MENTOR_PER_MIN=20

# ── AI Mentor ──  A = api (recommended) · B = off-VM ollama · C = in-VM · D = Jetson Nano
# Auto-fallback: with MENTOR_PROVIDER=api, the API is used ONLY if MENTOR_API_KEY is set;
# with no key it falls back to Ollama. Force a profile: MENTOR_PROVIDER=ollama | jetson.
MENTOR_PROVIDER=api
MENTOR_MAX_CONCURRENT=2             # shared, queued — never per-user

# Profile A (api):
MENTOR_API_BASE=https://api.anthropic.com
MENTOR_API_KEY=
MENTOR_API_MODEL=claude-haiku-4-5-20251001

# Profile B/C (ollama):  B → point at the LAN box · C → http://ollama:11434 (docker profile local-llm)
MENTOR_OLLAMA_BASE=http://ollama:11434
MENTOR_OLLAMA_MODEL=qwen2.5:3b

# Profile D (jetson):  offload the LLM onto a Jetson Nano running Ollama on the LAN.
# Set MENTOR_PROVIDER=jetson and point BASE at the Nano's IP:11434 (static IP > .local).
# On the Nano:  curl -fsSL https://ollama.com/install.sh | sh
#               OLLAMA_HOST=0.0.0.0 ollama serve   &&   ollama pull qwen2.5:3b
MENTOR_JETSON_BASE=http://jetson-nano.local:11434
MENTOR_JETSON_MODEL=qwen2.5:3b

# ── Frontend ──
WEB_PORT=8080
VITE_API_BASE=/api

# ── Bulk import + outbound email (nodemailer) ──
# Temporary emailed password validity (minutes). Requested at 8; raise if mail is slow.
TEMP_PASSWORD_TTL_MIN=8
# Leave SMTP_HOST empty to run without email (admin distributes the shown temp passwords).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=NIELIT Training <no-reply@nielit.gov.in>

# ── Tier-3 sandbox: apt-install for students, no direct internet ──
CONTAINER_NETWORK=nielit-labnet    # internal net (proxy only); set 'none' to fully isolate
